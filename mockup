import cv2
import numpy as np
import os
from IPython.display import Image as IPImage, display
from PIL import Image


def load_images(design_path, blank_mockup_path):
    """Loads the generated design and blank merchandise mockup."""
    design = cv2.imread(design_path, cv2.IMREAD_UNCHANGED)
    mockup = cv2.imread(blank_mockup_path, cv2.IMREAD_UNCHANGED)

    if design is None:
        raise FileNotFoundError(f"Design image not found at {design_path}")
    if mockup is None:
        raise FileNotFoundError(f"Mockup image not found at {blank_mockup_path}")

    return design, mockup


def create_depth_map(mockup):
    """Generates depth map directly from mockup image."""
    gray = cv2.cvtColor(mockup, cv2.COLOR_BGR2GRAY)
    gray = cv2.equalizeHist(gray)

    blurred = cv2.GaussianBlur(gray, (15, 15), 0)
    edges = cv2.Canny(blurred, 50, 150)

    depth_map = 255 - cv2.dilate(edges, None, iterations=3)

    sobelx = cv2.Sobel(gray, cv2.CV_64F, 1, 0, ksize=5)
    sobely = cv2.Sobel(gray, cv2.CV_64F, 0, 1, ksize=5)
    gradient = cv2.magnitude(sobelx, sobely)
    gradient = cv2.normalize(gradient, None, 0, 255, cv2.NORM_MINMAX)

    depth_map = cv2.addWeighted(depth_map.astype(np.float32), 0.7,
                                gradient.astype(np.float32), 0.3, 0)
    depth_map = cv2.GaussianBlur(depth_map, (51, 51), 0)
    return cv2.normalize(depth_map, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)


def apply_perspective_warp(design, pts_src, pts_dst, size):
    """Warps the design image to align with the mockup surface."""
    matrix = cv2.getPerspectiveTransform(pts_src, pts_dst)
    warped_design = cv2.warpPerspective(design, matrix, size)
    return warped_design


def apply_displacement_map(design, depth_map):
    """Uses a grayscale depth map to distort the design to match fabric texture."""
    displacement_x = cv2.Sobel(depth_map, cv2.CV_32F, 1, 0, ksize=5)
    displacement_y = cv2.Sobel(depth_map, cv2.CV_32F, 0, 1, ksize=5)

    rows, cols = design.shape[:2]
    map_x, map_y = np.meshgrid(np.arange(cols), np.arange(rows))
    map_x = map_x.astype(np.float32)
    map_y = map_y.astype(np.float32)

    map_x += displacement_x * 0.05
    map_y += displacement_y * 0.05

    displaced_design = cv2.remap(design, map_x, map_y, interpolation=cv2.INTER_LINEAR)
    return displaced_design


def extract_shadows(mockup):
    """Extracts shadows from the blank mockup to blend with the final output."""
    gray_mockup = cv2.cvtColor(mockup, cv2.COLOR_BGR2GRAY)
    blurred = cv2.GaussianBlur(gray_mockup, (21, 21), 10)
    edges = cv2.Canny(blurred, 50, 150)
    shadows = cv2.GaussianBlur(edges, (21, 21), 10)
    return shadows


def blend_mockup(warped_design, mockup, shadows):
    """Blends the warped design with the blank mockup and shadows."""
    final_mockup = cv2.addWeighted(mockup, 0.8, warped_design, 0.7, 0)

    if len(shadows.shape) == 2:
        shadows = cv2.cvtColor(shadows, cv2.COLOR_GRAY2BGR)

    final_mockup = cv2.subtract(final_mockup, shadows)
    return final_mockup


def generate_mockup(design_path, blank_mockup_path, pts_src, pts_dst, output_path):
    """Main function with integrated depth map generation and mockup creation."""
    design, mockup = load_images(design_path, blank_mockup_path)

    depth_map = create_depth_map(mockup)
    size = (mockup.shape[1], mockup.shape[0])

    warped_design = apply_perspective_warp(design, np.float32(pts_src), np.float32(pts_dst), size)
    displaced_design = apply_displacement_map(warped_design, depth_map)
    shadows = extract_shadows(mockup)
    final_mockup = blend_mockup(displaced_design, mockup, shadows)

    cv2.imwrite(output_path, final_mockup)
    print(f"✅ Mockup saved to: {output_path}")
    display(IPImage(filename=output_path))  # For Jupyter/Colab display


